// Bai OS UI — Slint + Rust
// หน้าล็อก / หน้าหลัก / ศูนย์ควบคุม / ตั้งค่า

component Glass inherits Rectangle {
    background: #ffffff1f;
    border-radius: 24px;
    border-width: 1px;
    border-color: #ffffff2e;
}

component Toggle inherits Rectangle {
    in-out property <bool> on;
    width: 52px;
    height: 30px;
    border-radius: 15px;
    background: root.on ? #34c759 : #ffffff33;
    animate background { duration: 220ms; }

    Rectangle {
        x: root.on ? 24px : 2px;
        y: 2px;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: white;
        animate x { duration: 220ms; easing: ease-in-out; }
    }

    TouchArea {
        clicked => { root.on = !root.on; }
    }
}

component GlassSlider inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <string> glyph;
    height: 56px;
    border-radius: 20px;
    background: #ffffff24;
    clip: true;

    Rectangle {
        x: 0px;
        width: root.width * root.value;
        background: #ffffffe6;
        animate width { duration: 60ms; }
    }

    Text {
        x: 18px;
        text: root.glyph;
        font-size: 20px;
        color: #26215c;
        vertical-alignment: center;
        height: parent.height;
    }

    ta := TouchArea {
        clicked => { root.value = Math.clamp(self.mouse-x / root.width, 0, 1); }
        moved => { root.value = Math.clamp(self.mouse-x / root.width, 0, 1); }
    }
}

component AppIcon inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <brush> tint;
    callback tapped();
    width: 76px;
    height: 92px;

    ta := TouchArea {
        clicked => { root.tapped(); }
    }

    Rectangle {
        width: ta.pressed ? 54px : 62px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (62px - self.height) / 2;
        border-radius: self.width * 0.3;
        background: root.tint;
        animate width { duration: 120ms; easing: ease-out; }

        Text {
            width: parent.width;
            height: parent.height;
            text: root.glyph;
            font-size: 28px;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        y: 68px;
        width: parent.width;
        text: root.label;
        font-size: 12px;
        color: #ffffffd9;
        horizontal-alignment: center;
    }
}

component QuickTile inherits Rectangle {
    in-out property <bool> on;
    in property <string> glyph;
    in property <string> label;
    in property <string> sub;
    height: 100px;
    border-radius: 24px;
    background: root.on ? #ffffffeb : #ffffff24;
    animate background { duration: 220ms; }

    Text {
        x: 16px;
        y: 14px;
        text: root.glyph;
        font-size: 24px;
        color: root.on ? #26215c : white;
    }
    Text {
        x: 16px;
        y: 58px;
        text: root.label;
        font-size: 14px;
        font-weight: 600;
        color: root.on ? #26215c : white;
    }
    Text {
        x: 16px;
        y: 76px;
        text: root.sub;
        font-size: 11px;
        color: root.on ? #534ab7 : #ffffffa6;
    }

    TouchArea {
        clicked => { root.on = !root.on; }
    }
}

component SettingRow inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <brush> tint;
    in property <bool> last: false;
    callback tapped();
    height: 58px;

    TouchArea { clicked => { root.tapped(); } }

    Rectangle {
        x: 14px;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: root.tint;
        Text {
            width: parent.width;
            height: parent.height;
            text: root.glyph;
            font-size: 17px;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 60px;
        text: root.title;
        font-size: 16px;
        color: white;
        vertical-alignment: center;
        height: parent.height;
    }
    Text {
        x: parent.width - 28px;
        text: "›";
        font-size: 22px;
        color: #ffffff80;
        vertical-alignment: center;
        height: parent.height;
    }
    if !root.last: Rectangle {
        x: 60px;
        y: parent.height - 1px;
        width: parent.width - 60px;
        height: 1px;
        background: #ffffff1a;
    }
}

component StatusBar inherits Rectangle {
    in property <string> clock;
    height: 44px;

    Text {
        x: 30px;
        text: root.clock;
        font-size: 15px;
        font-weight: 600;
        color: white;
        vertical-alignment: center;
        height: parent.height;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 10px;
        width: 112px;
        height: 30px;
        border-radius: 15px;
        background: #000000;
    }
    Text {
        x: parent.width - 100px;
        text: "5G";
        font-size: 13px;
        font-weight: 600;
        color: white;
        vertical-alignment: center;
        height: parent.height;
    }
    Rectangle {
        x: parent.width - 62px;
        y: 15px;
        width: 28px;
        height: 14px;
        border-radius: 4px;
        border-width: 1px;
        border-color: #ffffffb3;
        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width * 0.7;
            height: parent.height - 6px;
            border-radius: 2px;
            background: white;
        }
    }
}

export component AppWindow inherits Window {
    width: 390px;
    height: 844px;
    background: #0d0b1f;
    title: "Bai OS";

    in property <string> clock: "09:41";
    in property <string> date-text: "";

    // 0 = ล็อก, 1 = หน้าหลัก, 2 = ศูนย์ควบคุม, 3 = ตั้งค่า
    in-out property <int> screen: 0;
    in-out property <float> brightness: 0.7;
    in-out property <float> volume: 0.4;
    in-out property <bool> wifi: true;
    in-out property <bool> bluetooth: true;
    in-out property <bool> airplane: false;
    in-out property <bool> dnd: false;
    in-out property <bool> dark-mode: true;

    property <length> drift: 0px;
    animate drift { duration: 7s; easing: ease-in-out; }

    Timer {
        interval: 7s;
        running: true;
        triggered => { root.drift = root.drift == 0px ? 36px : 0px; }
    }

    // ---------- พื้นหลัง ----------
    Rectangle {
        background: @linear-gradient(165deg, #26215c 0%, #3c3489 55%, #72243e 100%);
    }
    Rectangle {
        x: -90px + root.drift;
        y: -40px;
        width: 380px;
        height: 380px;
        background: @radial-gradient(circle, #7f77dd88 0%, #7f77dd00 70%);
    }
    Rectangle {
        x: 120px - root.drift;
        y: 520px;
        width: 360px;
        height: 360px;
        background: @radial-gradient(circle, #d4537e77 0%, #d4537e00 70%);
    }
    Rectangle {
        background: #000000;
        opacity: root.screen == 3 ? 0.55 : (root.screen == 2 ? 0.35 : 0.0);
        animate opacity { duration: 350ms; easing: ease-out; }
    }

    // ---------- หน้าล็อก ----------
    lock := Rectangle {
        opacity: root.screen == 0 ? 1 : 0;
        y: root.screen == 0 ? 0px : -70px;
        visible: self.opacity > 0.01;
        animate opacity { duration: 380ms; easing: ease-out; }
        animate y { duration: 380ms; easing: ease-out; }

        StatusBar { y: 6px; width: parent.width; clock: ""; }

        Text {
            y: 110px;
            width: parent.width;
            text: root.date-text;
            font-size: 17px;
            color: #cecbf6;
            horizontal-alignment: center;
        }
        Text {
            y: 134px;
            width: parent.width;
            text: root.clock;
            font-size: 100px;
            font-weight: 300;
            color: white;
            horizontal-alignment: center;
        }

        Glass {
            x: 20px;
            y: 330px;
            width: parent.width - 40px;
            height: 76px;
            Text {
                x: 18px;
                y: 14px;
                text: "ข้อความใหม่";
                font-size: 14px;
                font-weight: 600;
                color: white;
            }
            Text {
                x: 18px;
                y: 38px;
                text: "คืนนี้เจอกันกี่โมง";
                font-size: 14px;
                color: #e6e4fb;
            }
        }

        Rectangle {
            x: 40px;
            y: parent.height - 130px;
            width: 54px;
            height: 54px;
            border-radius: 27px;
            background: #ffffff26;
            Text { text: "☀"; font-size: 22px; color: white; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
        }
        Rectangle {
            x: parent.width - 94px;
            y: parent.height - 130px;
            width: 54px;
            height: 54px;
            border-radius: 27px;
            background: #ffffff26;
            Text { text: "◉"; font-size: 22px; color: white; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
        }

        Text {
            y: parent.height - 52px;
            width: parent.width;
            text: "ปัดขึ้นเพื่อปลดล็อก";
            font-size: 13px;
            color: #cecbf6;
            horizontal-alignment: center;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 22px;
            width: 140px;
            height: 5px;
            border-radius: 3px;
            background: #ffffffcc;
        }

        TouchArea {
            y: 200px;
            height: parent.height - 200px;
            clicked => { root.screen = 1; }
            moved => {
                if (self.pressed-y - self.mouse-y > 80px) { root.screen = 1; }
            }
        }
    }

    // ---------- หน้าหลัก ----------
    home := Rectangle {
        opacity: root.screen == 1 ? 1 : 0;
        y: root.screen == 1 ? 0px : 40px;
        visible: self.opacity > 0.01;
        animate opacity { duration: 380ms; easing: ease-out; }
        animate y { duration: 380ms; easing: ease-out; }

        StatusBar { y: 6px; width: parent.width; clock: root.clock; }

        Glass {
            x: 20px;
            y: 66px;
            width: parent.width - 40px;
            height: 130px;
            Text { x: 20px; y: 18px; text: "กรุงเทพฯ"; font-size: 15px; color: #e6e4fb; }
            Text { x: 20px; y: 40px; text: "28°"; font-size: 54px; font-weight: 300; color: white; }
            Text { x: 20px; y: 102px; text: "มีเมฆบางส่วน"; font-size: 13px; color: #cecbf6; }
            Text { x: parent.width - 76px; y: 28px; text: "☁"; font-size: 46px; color: white; }
        }

        GridLayout {
            x: 20px;
            y: 224px;
            width: parent.width - 40px;
            spacing-vertical: 16px;
            Row {
                AppIcon { glyph: "⚙"; label: "ตั้งค่า"; tint: #1d9e75; tapped => { root.screen = 3; } }
                AppIcon { glyph: "▦"; label: "ปฏิทิน"; tint: #378add; }
                AppIcon { glyph: "◐"; label: "รูปภาพ"; tint: #d85a30; }
                AppIcon { glyph: "♪"; label: "เพลง"; tint: #d4537e; }
            }
            Row {
                AppIcon { glyph: "⌖"; label: "แผนที่"; tint: #534ab7; }
                AppIcon { glyph: "✎"; label: "โน้ต"; tint: #ba7517; }
                AppIcon { glyph: "฿"; label: "กระเป๋า"; tint: #639922; }
                AppIcon { glyph: "✉"; label: "อีเมล"; tint: #185fa5; }
            }
            Row {
                AppIcon { glyph: "▶"; label: "วิดีโอ"; tint: #a32d2d; }
                AppIcon { glyph: "☎"; label: "ติดต่อ"; tint: #0f6e56; }
                AppIcon { glyph: "⏱"; label: "นาฬิกา"; tint: #5f5e5a; }
                AppIcon { glyph: "☁"; label: "สภาพอากาศ"; tint: #185fa5; }
            }
        }

        Glass {
            x: 20px;
            y: parent.height - 120px;
            width: parent.width - 40px;
            height: 84px;
            border-radius: 32px;
            HorizontalLayout {
                alignment: space-around;
                padding-top: 11px;
                AppIcon { glyph: "☎"; label: ""; tint: #1d9e75; }
                AppIcon { glyph: "✉"; label: ""; tint: #378add; }
                AppIcon { glyph: "◎"; label: ""; tint: #d85a30; }
                AppIcon { glyph: "◉"; label: ""; tint: #888780; }
            }
        }

        // ปัดลงจากขอบบน = เปิดศูนย์ควบคุม
        TouchArea {
            height: 52px;
            moved => {
                if (self.mouse-y - self.pressed-y > 60px) { root.screen = 2; }
            }
        }
        // แตะแถบล่าง = ล็อกเครื่อง
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 20px;
            width: 140px;
            height: 5px;
            border-radius: 3px;
            background: #ffffffcc;
        }
        TouchArea {
            x: (parent.width - 180px) / 2;
            y: parent.height - 34px;
            width: 180px;
            height: 34px;
            clicked => { root.screen = 0; }
        }
    }

    // ---------- ศูนย์ควบคุม ----------
    control := Rectangle {
        opacity: root.screen == 2 ? 1 : 0;
        y: root.screen == 2 ? 0px : -60px;
        visible: self.opacity > 0.01;
        animate opacity { duration: 380ms; easing: ease-out; }
        animate y { duration: 380ms; easing: ease-out; }

        StatusBar { y: 6px; width: parent.width; clock: root.clock; }

        VerticalLayout {
            x: 20px;
            y: 68px;
            width: parent.width - 40px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                QuickTile { glyph: "◈"; label: "Wi-Fi"; sub: self.on ? "BaiJak_5G" : "ปิด"; on <=> root.wifi; }
                QuickTile { glyph: "ᛒ"; label: "บลูทูธ"; sub: self.on ? "เปิด" : "ปิด"; on <=> root.bluetooth; }
            }
            HorizontalLayout {
                spacing: 12px;
                QuickTile { glyph: "✈"; label: "โหมดเครื่องบิน"; sub: self.on ? "เปิด" : "ปิด"; on <=> root.airplane; }
                QuickTile { glyph: "☾"; label: "ห้ามรบกวน"; sub: self.on ? "เปิด" : "ปิด"; on <=> root.dnd; }
            }
            GlassSlider { glyph: "☀"; value <=> root.brightness; }
            GlassSlider { glyph: "♫"; value <=> root.volume; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 20px;
            width: 140px;
            height: 5px;
            border-radius: 3px;
            background: #ffffffcc;
        }
        TouchArea {
            y: 420px;
            height: parent.height - 420px;
            clicked => { root.screen = 1; }
            moved => {
                if (self.pressed-y - self.mouse-y > 70px) { root.screen = 1; }
            }
        }
    }

    // ---------- ตั้งค่า ----------
    settings := Rectangle {
        opacity: root.screen == 3 ? 1 : 0;
        x: root.screen == 3 ? 0px : 60px;
        visible: self.opacity > 0.01;
        animate opacity { duration: 320ms; easing: ease-out; }
        animate x { duration: 320ms; easing: ease-out; }

        StatusBar { y: 6px; width: parent.width; clock: root.clock; }

        Rectangle {
            x: 14px;
            y: 56px;
            width: 60px;
            height: 36px;
            TouchArea { clicked => { root.screen = 1; } }
            Text { text: "‹ กลับ"; font-size: 16px; color: #afa9ec; vertical-alignment: center; height: parent.height; }
        }
        Text {
            x: 24px;
            y: 98px;
            text: "ตั้งค่า";
            font-size: 34px;
            font-weight: 700;
            color: white;
        }

        Glass {
            x: 20px;
            y: 154px;
            width: parent.width - 40px;
            height: 44px;
            border-radius: 14px;
            Text { x: 14px; text: "⌕  ค้นหาการตั้งค่า"; font-size: 15px; color: #ffffff99; vertical-alignment: center; height: parent.height; }
        }

        Glass {
            x: 20px;
            y: 218px;
            width: parent.width - 40px;
            height: 58px * 5;
            border-radius: 18px;
            clip: true;
            VerticalLayout {
                SettingRow { glyph: "◈"; title: "Wi-Fi"; tint: #378add; }
                SettingRow { glyph: "♪"; title: "การแจ้งเตือน"; tint: #d85a30; }
                SettingRow { glyph: "◐"; title: "หน้าจอและธีม"; tint: #d4537e; }
                SettingRow { glyph: "▮"; title: "แบตเตอรี่"; tint: #639922; }
                SettingRow { glyph: "⚿"; title: "ความเป็นส่วนตัว"; tint: #534ab7; last: true; }
            }
        }

        Glass {
            x: 20px;
            y: 218px + 58px * 5 + 18px;
            width: parent.width - 40px;
            height: 62px;
            border-radius: 18px;
            Text { x: 60px; text: "โหมดมืด"; font-size: 16px; color: white; vertical-alignment: center; height: parent.height; }
            Rectangle {
                x: 14px;
                y: 15px;
                width: 32px;
                height: 32px;
                border-radius: 10px;
                background: #888780;
                Text { text: "☾"; font-size: 17px; color: white; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
            }
            Toggle {
                x: parent.width - self.width - 16px;
                y: 16px;
                on <=> root.dark-mode;
            }
        }
    }
}
